<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerInParent="true"
    android:gravity="center"
    android:orientation="vertical" >

    <TextView
        android:id="@+id/txt_exercise_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="20 km"
        android:textColor="#ff7f7f7f"
        android:textSize="50sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center|left"
        android:orientation="vertical" >

        <TextView
            android:id="@+id/txt_exercise_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/exercise_time"
            android:drawablePadding="5dp"
            android:gravity="center_vertical|center_horizontal"
            android:paddingRight="5dp"
            android:text="1"
            android:textColor="#ff7f7f7f"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/txt_exercise_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/exercise_speed"
            android:drawablePadding="5dp"
            android:gravity="center_vertical|center_horizontal"
            android:paddingRight="5dp"
            android:text="2"
            android:textColor="#ff7f7f7f" 
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/txt_exercise_caloric"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/exercise_caloric"
            android:drawablePadding="5dp"
            android:gravity="center_vertical|center_horizontal"
            android:paddingRight="5dp"
            android:text="3"
            android:textColor="#ff7f7f7f"
            android:textSize="20sp" />
    </LinearLayout>

</LinearLayout>