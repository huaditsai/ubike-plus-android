<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/RelativeLayout1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="blocksDescendants" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/radiuslayout"
        android:padding="10dp" >

        <ImageView
            android:id="@+id/item_img_pin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginRight="10dp"
            android:src="@drawable/ic_launcher" />

        <LinearLayout
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/item_txt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/item_txt_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:textColor="#58595b" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="left"
                android:orientation="horizontal" >

                <TextView
                    android:id="@+id/item_txt_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:gravity="center_vertical|left"
                    android:textColor="#58595b" />

                <TextView
                    android:id="@+id/item_txt_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|left"
                    android:textColor="#58595b" />
            </LinearLayout>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="left|center_vertical"
                android:orientation="horizontal" >
	
	            <TextView 
	                android:id="@+id/item_txt_bike" 
	                android:layout_width="wrap_content" 
	                android:layout_height="wrap_content" 
	                android:drawableLeft="@drawable/myinfo_bike" 
	                android:drawablePadding="5dp" 
	                android:paddingRight="10dp" 
	                android:textColor="#58595b" />
	
	            <TextView 
	                android:id="@+id/item_txt_stop" 
	                android:layout_width="wrap_content" 
	                android:layout_height="wrap_content" 
	                android:drawableLeft="@drawable/myinfo_parking" 
	                android:drawablePadding="5dp" 
	                android:paddingRight="10dp"
	                android:textColor="#58595b" />
	            
        	</LinearLayout>
        </LinearLayout>

        

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginRight="0dp"
            android:src="@drawable/arraw" />
    </LinearLayout>

</RelativeLayout>