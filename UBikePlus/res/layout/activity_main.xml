<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity" >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

        <fragment
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            class="com.google.android.gms.maps.MapFragment" >
        </fragment>

        <ImageButton
            android:id="@+id/btn_myLocat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true"
            android:layout_margin="20dp"
            android:background="#00000000"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/map_location" />
        
        
            
        <LinearLayout 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content"
            android:gravity="right"
            android:orientation="vertical">
            
	        <LinearLayout 
	            android:layout_width="match_parent" 
	            android:layout_height="wrap_content" 
	            android:background="@drawable/actionbar_bg"
	            android:padding="10dp" 
	            android:orientation="horizontal">
	
	            <ImageButton 
	                android:id="@+id/drawerHomeButton" 
	                android:layout_width="wrap_content" 
	                android:layout_height="wrap_content" 
	                android:background="@android:color/transparent" 
	                android:scaleType="fitCenter" 
	                android:src="@drawable/slide_menu_00" />
	
	            <SearchView 
	                android:id="@+id/searchView1" 
	                android:layout_width="wrap_content" 
	                android:layout_height="wrap_content"
	                android:paddingLeft="10dp"
	                android:background="@android:drawable/editbox_dropdown_light_frame" 
	                android:iconifiedByDefault="false" 
	                android:queryHint="@string/search_title" />
	                            
	        </LinearLayout>
	            
	            <ImageButton 
	                android:id="@+id/btn_compass" 
	                android:layout_width="wrap_content" 
	                android:layout_height="wrap_content" 
	                android:padding="10dp"
	                android:background="@android:color/transparent" 
	                android:contentDescription="@string/app_name"
	                android:src="@drawable/map_compass" />
	            
            </LinearLayout>
        
        <LinearLayout
            android:id="@+id/layout_exercise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:background="#CF000000"
            android:orientation="vertical" >
        </LinearLayout>
        

        <ListView
            android:id="@+id/searchList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:visibility="invisible" />


    </RelativeLayout>

    <!-- The navigation drawer -->

    <ListView
        android:id="@+id/left_drawer"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#303030"
        android:choiceMode="multipleChoice"
        android:divider="@android:color/transparent"
        android:dividerHeight="5dp"
        android:paddingBottom="20dp" />


</android.support.v4.widget.DrawerLayout>